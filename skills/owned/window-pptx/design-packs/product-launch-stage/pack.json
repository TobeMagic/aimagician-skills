{
  "schema_version": "1.0",
  "id": "product-launch-stage",
  "name": "Product Launch Stage",
  "runtime_theme_id": "technology",
  "scenarios": ["product-launch", "sales-proposal", "investor-pitch", "brand-introduction", "ecommerce-marketing"],
  "theme": {
    "mode": "dark",
    "primary": "111827",
    "accent": "7C3AED",
    "background": "090B10",
    "heading_font": ["Inter Display", "Arial", "Noto Sans CJK SC"],
    "body_font": ["Inter", "Arial", "Noto Sans CJK SC"]
  },
  "page_families": ["cover", "section", "problem-hero", "product-hero", "big-number", "feature-bento", "before-after", "demo-flow", "architecture", "social-proof", "pricing", "roadmap", "team", "cta", "closing"],
  "pacing": {
    "max_same_family_run": 2,
    "hero_interval": 3,
    "density_pattern": ["sparse", "balanced", "sparse", "dense"]
  },
  "asset_strategy": {
    "priority": ["user", "generated", "licensed", "native"],
    "required_for": ["cover", "product-hero", "feature-bento", "social-proof"]
  },
  "safe_fallback": {
    "family": "stage-hero-with-proof-strip",
    "max_body_chars": 120,
    "max_items": 4
  }
}
