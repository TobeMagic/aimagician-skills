{
  "schema_version": "2.0",
  "id": "institutional-annual-editorial",
  "name": "Institutional Annual Editorial",
  "runtime_theme_id": "public-enterprise",
  "scenarios": ["business-report", "annual-review", "strategy-planning", "operations-review", "project-kickoff", "brand-introduction"],
  "theme": {
    "mode": "mixed",
    "primary": "26594F",
    "accent": "8A5C16",
    "background": "F3F0E8",
    "heading_font": ["Source Han Serif SC", "Noto Serif CJK SC", "Microsoft YaHei"],
    "body_font": ["Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei"]
  },
  "page_families": ["cover", "contents", "section", "executive-summary", "big-number", "kpi-towers", "chart-story", "comparison", "card-grid", "org-map", "team-orbit", "roadmap", "risk-actions", "summary", "closing"],
  "pacing": {
    "max_same_family_run": 2,
    "hero_interval": 4,
    "density_pattern": ["sparse", "balanced", "dense", "balanced"]
  },
  "asset_strategy": {
    "priority": ["user", "template", "licensed", "generated", "native"],
    "required_for": ["cover", "section", "team-orbit", "roadmap"]
  },
  "safe_fallback": {
    "family": "editorial-statement-with-kpi-rail",
    "max_body_chars": 180,
    "max_items": 5
  },
  "template_pack": "institutional-work-summary-v1",
  "art_direction": {
    "id": "institutional-beacon",
    "palette_roles": {
      "canvas": "F3F0E8",
      "ink": "173B35",
      "teal": "268273",
      "gold": "8A5C16",
      "surface": "FBF9F4",
      "muted": "6C7773"
    },
    "grid": {
      "columns": 12,
      "safe_margin_in": 0.6,
      "spacing_scale_pt": [4, 8, 12, 16, 24, 32, 48]
    },
    "typography_scale_pt": {
      "display": 52,
      "title": 32,
      "subtitle": 22,
      "body": 16,
      "caption": 11
    },
    "motif": {
      "variants": ["beacon-ring", "ceremonial-band", "milestone-seal", "horizon-line"]
    },
    "image_crop": "editorial-center-with-title-safe-zone",
    "icon_style": "outlined-institutional-consistent",
    "surface": {
      "corner_radius_pt": 6,
      "stroke_pt": 1,
      "shadow_mode": "soft-layered-paper"
    },
    "energy_pattern": ["peak", "pause", "flow", "flow"],
    "quality_thresholds": {
      "engineering": 100,
      "visual": 80,
      "art": 75,
      "release": 84,
      "axis_floor": 75
    }
  }
}
