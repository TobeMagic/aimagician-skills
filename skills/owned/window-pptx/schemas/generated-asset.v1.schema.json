{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-asset.v1.schema.json",
  "title": "Window PPTX Generated Asset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "model",
    "prompt_sha256",
    "input_sha256",
    "output_sha256",
    "size",
    "content_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "route_id": {"const": "agnes-direct/agnes-image-2.1-flash"},
    "model": {"const": "agnes-image-2.1-flash"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"},
    "content_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "text", "logos", "watermarks"],
      "properties": {
        "facts": {"const": "forbidden"},
        "text": {"const": "forbidden"},
        "logos": {"const": "forbidden"},
        "watermarks": {"const": "forbidden"}
      }
    },
    "b64_json": {"type": "string", "minLength": 1}
  }
}
