{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://window-pptx.local/schemas/page-template-query-request.v1.schema.json",
  "title": "Page Template Query Request v1",
  "type": "object",
  "required": ["schema_version", "slides"],
  "properties": {
    "schema_version": {"const": "page-template-query-request.v1"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["target_ordinal", "role", "capacity_budget"],
        "properties": {
          "target_ordinal": {"type": "integer", "minimum": 1},
          "required_source_ordinal": {"type": "integer", "minimum": 1},
          "query_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "capacity_budget": {"type": "integer", "minimum": 1},
          "semantic_categories": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "asset_requirements": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "customer_assets_available": {"type": "boolean"},
          "style_cluster": {"type": "string", "minLength": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 10},
          "allow_fallback": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
