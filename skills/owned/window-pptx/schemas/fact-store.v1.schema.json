{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-store.v1.schema.json",
  "title": "window-pptx FactStore v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "sources", "facts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "objective": {"type": "string", "minLength": 1, "maxLength": 500},
        "audience": {"type": "string", "minLength": 1, "maxLength": 160},
        "language": {"type": "string", "minLength": 2, "maxLength": 20}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["request", "document", "data", "manual"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 500},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "language", "source_id", "locator", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["claim", "metric", "quote", "date", "instruction", "label"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000},
          "language": {"type": "string", "minLength": 2, "maxLength": 20},
          "source_id": {"$ref": "#/$defs/id"},
          "locator": {"type": "string", "minLength": 1, "maxLength": 500},
          "required": {"type": "boolean"},
          "value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "unit": {"type": "string", "minLength": 1, "maxLength": 80},
          "claim_key": {"$ref": "#/$defs/id"},
          "time_scope": {"type": "string", "minLength": 1, "maxLength": 120},
          "status": {"enum": ["active", "superseded", "disputed"]},
          "recommended_beat": {"$ref": "#/$defs/id"},
          "recommended_semantic": {"enum": ["bullets", "metrics", "comparison", "sequence", "timeline", "process", "roadmap", "quadrant", "funnel", "trend", "composition", "matrix", "risk", "recommendation", "quote", "table", "image", "statement", "generic"]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80}
  }
}
