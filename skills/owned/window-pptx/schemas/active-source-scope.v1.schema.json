{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/active-source-scope.v1.schema.json",
  "title": "PPTX Studio Active Source Scope v1",
  "type": "object",
  "required": ["schema_version", "source_kind", "active_categories"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_kind": {"const": "gaojie"},
    "active_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
