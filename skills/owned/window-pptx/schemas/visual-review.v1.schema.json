{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-review.v1.schema.json",
  "title": "Window PPTX Visual Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "observations",
    "findings",
    "scores",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scope": {"enum": ["slide", "deck"]},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "region", "evidence"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "region": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "slide_id",
          "region",
          "evidence",
          "repair_code"
        ],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["minor", "important", "blocker"]},
          "slide_id": {"type": "string", "minLength": 1},
          "region": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "repair_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hierarchy_readability",
        "composition_space",
        "art_direction",
        "business_evidence",
        "deck_rhythm",
        "asset_polish"
      ],
      "properties": {
        "hierarchy_readability": {"type": "number", "minimum": 0, "maximum": 100},
        "composition_space": {"type": "number", "minimum": 0, "maximum": 100},
        "art_direction": {"type": "number", "minimum": 0, "maximum": 100},
        "business_evidence": {"type": "number", "minimum": 0, "maximum": 100},
        "deck_rhythm": {"type": "number", "minimum": 0, "maximum": 100},
        "asset_polish": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "verdict": {"enum": ["PASS", "FAIL"]},
    "probe_token": {"type": "string", "minLength": 1}
  }
}
