{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://window-pptx.local/schemas/page-template-candidate.v1.schema.json",
  "title": "Page Template Candidate v1",
  "description": "One deterministic page-template query result with eligibility and weighted score evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "page_id",
    "eligibility",
    "reasons",
    "fallback_reason",
    "asset_fit",
    "capacity_fit",
    "residue_risk",
    "style_compatibility",
    "scores",
    "weights",
    "page_template"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "page_id": {"type": "string", "pattern": "^[0-9a-f]{64}:[0-9]{3}$"},
    "eligibility": {"type": "boolean"},
    "reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "fallback_reason": {"type": ["string", "null"]},
    "asset_fit": {"type": "number", "minimum": 0, "maximum": 1},
    "capacity_fit": {"type": "boolean"},
    "residue_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "style_compatibility": {
      "enum": ["exact", "registered", "incompatible"]
    },
    "scores": {
      "type": "object",
      "required": ["role", "capacity", "semantic", "style", "editability", "total"],
      "properties": {
        "role": {"type": "number", "minimum": 0, "maximum": 1},
        "capacity": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic": {"type": "number", "minimum": 0, "maximum": 1},
        "style": {"type": "number", "minimum": 0, "maximum": 1},
        "editability": {"type": "number", "minimum": 0, "maximum": 1},
        "total": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "weights": {
      "const": {
        "role": 0.3,
        "capacity": 0.25,
        "semantic": 0.2,
        "style": 0.15,
        "editability": 0.1
      }
    },
    "page_template": {"$ref": "page-template.v1.schema.json"}
  },
  "additionalProperties": false
}
