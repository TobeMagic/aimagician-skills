{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-pack.v1.schema.json",
  "title": "Window-PPTX DesignPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "runtime_theme_id",
    "scenarios",
    "theme",
    "page_families",
    "pacing",
    "asset_strategy",
    "safe_fallback"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "runtime_theme_id": {"type": "string", "minLength": 1},
    "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "primary", "accent", "background", "heading_font", "body_font"],
      "properties": {
        "mode": {"enum": ["light", "dark", "mixed"]},
        "primary": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "background": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "heading_font": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "body_font": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "page_families": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_same_family_run", "hero_interval", "density_pattern"],
      "properties": {
        "max_same_family_run": {"type": "integer", "minimum": 1, "maximum": 3},
        "hero_interval": {"type": "integer", "minimum": 2, "maximum": 8},
        "density_pattern": {"type": "array", "minItems": 3, "items": {"enum": ["sparse", "balanced", "dense"]}}
      }
    },
    "asset_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "required_for"],
      "properties": {
        "priority": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["user", "template", "licensed", "generated", "native"]}},
        "required_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "safe_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "max_body_chars", "max_items"],
      "properties": {
        "family": {"type": "string"},
        "max_body_chars": {"type": "integer", "minimum": 40},
        "max_items": {"type": "integer", "minimum": 2}
      }
    },
    "template_pack": {"type": "string"}
  }
}
