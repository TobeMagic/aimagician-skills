{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-geometry-inventory.v1.schema.json",
  "title": "Window-PPTX TemplatePack geometry inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_pack_id",
    "template_sha256",
    "slide_count",
    "shape_target_count",
    "chart_target_count",
    "masks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "template_pack_id": {"type": "string", "minLength": 1},
    "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slide_count": {"type": "integer", "minimum": 1},
    "shape_target_count": {"type": "integer", "minimum": 0},
    "chart_target_count": {"type": "integer", "minimum": 0},
    "masks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "template-pack.v1.schema.json#/$defs/visual_mask"}
    }
  }
}
