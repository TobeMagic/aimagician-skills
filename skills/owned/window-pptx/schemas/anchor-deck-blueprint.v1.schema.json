{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor-deck-blueprint.v1.schema.json",
  "title": "Window-PPTX reference-grade anchor deck blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "theme_id",
    "source_brief",
    "source_brief_sha256",
    "output_file",
    "output_sha256",
    "slide_count",
    "native_editable",
    "whole_slide_rasterization",
    "generated_hero_assets",
    "candidate_policy",
    "slides"
  ],
  "properties": {
    "schema_version": {"const": "anchor-deck-blueprint.v1"},
    "scenario_id": {
      "enum": [
        "annual-work-report",
        "campus-competition-defense",
        "academic-thesis-defense"
      ]
    },
    "theme_id": {"type": "string", "minLength": 1},
    "source_brief": {"type": "string", "minLength": 1},
    "source_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_file": {"type": "string", "pattern": "\\.pptx$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slide_count": {"type": "integer", "minimum": 12, "maximum": 24},
    "native_editable": {"const": true},
    "whole_slide_rasterization": {"const": false},
    "generated_hero_assets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "policy"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "policy": {"const": "local-project-bound-image"}
        }
      }
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_prefix",
        "native_prefix",
        "reference_only_materialized"
      ],
      "properties": {
        "physical_prefix": {"type": "string", "minLength": 1},
        "native_prefix": {"type": "string", "minLength": 1},
        "template_prefix": {"type": "string", "minLength": 1},
        "reference_only_materialized": {"const": false}
      }
    },
    "template_materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_pack_id",
        "source_sha256",
        "output_sha256",
        "changed_parts",
        "slot_change_count",
        "source_integrity_preserved",
        "whole_slide_rasterization"
      ],
      "properties": {
        "template_pack_id": {"const": "institutional-work-summary-v1"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_parts": {
          "type": "array",
          "minItems": 15,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "slot_change_count": {"type": "integer", "minimum": 200},
        "source_integrity_preserved": {"const": true},
        "whole_slide_rasterization": {"const": false}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 12,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "role",
          "family",
          "density",
          "candidate_id"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^(work|campus|academic)-[0-9]{2}$"
          },
          "role": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "density": {"enum": ["sparse", "medium", "dense"]},
          "candidate_id": {
            "type": "string",
            "pattern": "^(physical:[0-9a-f]{64}:[0-9]{3}|native:[a-z0-9][a-z0-9._-]+|template:physical\\.work-summary\\.s[0-9]{2})$"
          }
        }
      }
    }
  }
}
