{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://window-pptx.local/schemas/assembly-plan.v1.schema.json",
  "title": "Assembly Plan v1",
  "description": "Codex-authored plan linking each target slide to a chosen page_id and required bindings.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "scenario_id",
    "dominant_style_cluster_id",
    "created_at",
    "target_slide_count",
    "target_slides",
    "library_index_sha256",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "dominant_style_cluster_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "target_slide_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "target_slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal", "narrative_role", "page_id", "package_sha256", "slide_number",
          "title", "bindings"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "narrative_role": {"type": "string", "minLength": 1},
          "page_id": {"type": "string", "pattern": "^[0-9a-f]{64}:[0-9]{3}$"},
          "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "slide_number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 60},
          "headline": {"type": "string", "maxLength": 80},
          "narrative_intent": {"type": "string", "maxLength": 240},
          "bindings": {
            "type": "object",
            "description": "Per-shape locked binding. Text shapes carry text+fact_refs; picture shapes carry exactly one asset_ref. The engine infers and validates the allowed fact rendering.",
            "additionalProperties": {"$ref": "#/$defs/slotBinding"}
          },
          "selection": {
            "type": "object",
            "required": [
              "query_id", "candidate_rank", "score_total",
              "selection_reason", "fallback_reason"
            ],
            "properties": {
              "query_id": {"type": "string", "minLength": 1},
              "candidate_rank": {"type": "integer", "minimum": 1, "maximum": 10},
              "score_total": {"type": "number", "minimum": 0, "maximum": 1},
              "selection_reason": {"type": "string", "minLength": 1, "maxLength": 240},
              "fallback_reason": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "library_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding_profile_authority": {"$ref": "#/$defs/bindingProfileAuthority"},
    "query_bundle": {"$ref": "#/$defs/authorityFile"},
    "authority": {
      "type": "object",
      "required": ["fact_store", "asset_manifest", "connective_copy"],
      "properties": {
        "fact_store": {"$ref": "#/$defs/authorityFile"},
        "asset_manifest": {"$ref": "#/$defs/authorityFile"},
        "connective_copy": {"$ref": "#/$defs/authorityFile"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bindingProfileAuthority": {
      "type": "object",
      "required": ["profile_id", "profile_sha256"],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,120}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "authorityFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\\\]+$",
          "description": "Project-relative POSIX path; the production loader also rejects path escape and every symlink component."
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "slotBinding": {
      "type": "object",
      "required": ["text", "fact_refs", "asset_refs"],
      "properties": {
        "text": {"type": "string"},
        "fact_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "maxItems": 8
        },
        "asset_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "maxItems": 1
        },
        "fit_policy": {"enum": ["preserve", "no-autofit", "shrink-to-fit"]}
      },
      "additionalProperties": false
    }
  }
}
