{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/rights-record.v1.schema.json",
  "title": "Window-PPTX RightsRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_id",
    "item_id",
    "access_basis",
    "use_scope",
    "redistribution_state",
    "evidence_references",
    "reviewed_at",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PASS", "NEEDS_RIGHTS"]},
    "source_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "minLength": 1},
    "access_basis": {
      "enum": ["public", "owned", "licensed", "client_authorized", "unknown"]
    },
    "use_scope": {
      "enum": ["metadata_only", "local_adaptation", "client_delivery", "redistribution"]
    },
    "redistribution_state": {
      "enum": ["allowed", "restricted", "prohibited", "unknown"]
    },
    "evidence_references": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["allowed", "restricted", "unknown"]}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "allowed"}}},
      "then": {
        "properties": {
          "status": {"const": "PASS"},
          "evidence_references": {"minItems": 1}
        },
        "not": {
          "properties": {
            "access_basis": {"const": "unknown"}
          },
          "required": ["access_basis"]
        }
      }
    },
    {
      "if": {"properties": {"decision": {"enum": ["restricted", "unknown"]}}},
      "then": {"properties": {"status": {"const": "NEEDS_RIGHTS"}}}
    }
  ]
}
