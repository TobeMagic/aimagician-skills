{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/pptx-studio-catalog.v1.schema.json",
  "title": "PPTX Studio Catalog v1",
  "type": "object",
  "required": ["schema_version", "catalog_id", "source_kind", "active_categories", "deck_count", "page_count", "region_count", "category_index", "decks", "pages", "regions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "source_kind": {"const": "gaojie"},
    "active_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "deck_count": {"type": "integer", "minimum": 0},
    "page_count": {"type": "integer", "minimum": 0},
    "region_count": {"type": "integer", "minimum": 0},
    "category_index": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "decks": {"type": "array"},
    "pages": {"type": "array"},
    "regions": {"type": "array"}
  },
  "additionalProperties": false
}
