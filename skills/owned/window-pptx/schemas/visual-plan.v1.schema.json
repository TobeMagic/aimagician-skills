{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-plan.v1.schema.json",
  "title": "Window-PPTX VisualPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_pack_id", "theme_id", "slides"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "design_pack_id": {"type": "string"},
    "template_pack_id": {"type": ["string", "null"]},
    "theme_id": {"type": "string"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "role", "family", "variant", "emphasis", "density", "components"],
        "properties": {
          "slide_id": {"type": "string"},
          "role": {"type": "string"},
          "family": {"type": "string"},
          "variant": {"type": "string"},
          "emphasis": {"enum": ["quiet", "standard", "hero"]},
          "density": {"enum": ["sparse", "balanced", "dense"]},
          "components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "asset_refs": {"type": "array", "items": {"type": "string"}},
          "decision_rules": {"type": "array", "items": {"type": "string"}},
          "recipe_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
