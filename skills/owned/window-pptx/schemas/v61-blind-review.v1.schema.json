{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/v61-blind-review.v1.schema.json",
  "title": "Window-PPTX v6.1 Independent Blind Review",
  "description": "One fresh-context synthesis over two hash-bound Agnes visual segments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "reviewer_id",
    "packet_sha256",
    "rubric_sha256",
    "synthesis_model_id",
    "synthesis_context_id",
    "context_mode",
    "prompt_sha256",
    "response_sha256",
    "segment_refs",
    "inspected_slides",
    "scores",
    "median_score",
    "reference_parity",
    "findings",
    "status",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_id": {"const": "window-pptx-v61-blind-v1"},
    "reviewer_id": {"enum": ["ART", "NARRATIVE", "PRODUCTION"]},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "synthesis_model_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "synthesis_context_id": {"$ref": "#/$defs/executionId"},
    "context_mode": {"const": "fresh-isolated"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "response_sha256": {"$ref": "#/$defs/sha256"},
    "segment_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/segmentRef"}
    },
    "inspected_slides": {
      "type": "array",
      "prefixItems": [
        {"const": 1}, {"const": 2}, {"const": 3}, {"const": 4},
        {"const": 5}, {"const": 6}, {"const": 7}, {"const": 8},
        {"const": 9}, {"const": 10}, {"const": 11}, {"const": 12},
        {"const": 13}, {"const": 14}, {"const": 15}
      ],
      "items": false,
      "minItems": 15,
      "maxItems": 15
    },
    "scores": {"$ref": "#/$defs/scores"},
    "median_score": {"type": "number", "minimum": 0, "maximum": 10},
    "reference_parity": {"type": "boolean"},
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/finding"}
    },
    "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "failure_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "notes": {"type": "string", "minLength": 1, "maxLength": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "NOT_RUN"}}},
      "then": {"required": ["failure_reason"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "segmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "document_sha256", "invocation_id"],
      "properties": {
        "segment_id": {"enum": ["SLIDES_01_08", "SLIDES_09_15"]},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "invocation_id": {"$ref": "#/$defs/executionId"}
      }
    },
    "score": {"type": "number", "minimum": 0, "maximum": 10},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrative_logic",
        "visual_hierarchy",
        "layout_craft",
        "typography_readability",
        "data_visualization",
        "visual_rhythm",
        "brand_coherence",
        "art_direction",
        "delivery_readiness"
      ],
      "properties": {
        "narrative_logic": {"$ref": "#/$defs/score"},
        "visual_hierarchy": {"$ref": "#/$defs/score"},
        "layout_craft": {"$ref": "#/$defs/score"},
        "typography_readability": {"$ref": "#/$defs/score"},
        "data_visualization": {"$ref": "#/$defs/score"},
        "visual_rhythm": {"$ref": "#/$defs/score"},
        "brand_coherence": {"$ref": "#/$defs/score"},
        "art_direction": {"$ref": "#/$defs/score"},
        "delivery_readiness": {"$ref": "#/$defs/score"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "dimension", "slides", "evidence"],
      "properties": {
        "severity": {"enum": ["Blocker", "Important", "Nitpick"]},
        "dimension": {
          "enum": [
            "narrative_logic",
            "visual_hierarchy",
            "layout_craft",
            "typography_readability",
            "data_visualization",
            "visual_rhythm",
            "brand_coherence",
            "art_direction",
            "delivery_readiness"
          ]
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 15}
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
