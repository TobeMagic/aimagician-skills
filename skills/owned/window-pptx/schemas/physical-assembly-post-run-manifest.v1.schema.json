{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-assembly-post-run-manifest.v1.schema.json",
  "title": "Window-PPTX v6.1 Physical Assembly Post-Run Manifest",
  "description": "Externally captured, byte-bound inventory of every regular file remaining in the clean project after the author run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "project_root",
    "recursive",
    "digest_algorithm",
    "inventory_sha256",
    "entry_count",
    "total_size",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"$ref": "#/$defs/id"},
    "project_root": {"type": "string", "pattern": "^/", "minLength": 2, "maxLength": 2000},
    "recursive": {"const": true},
    "digest_algorithm": {"const": "canonical-file-records-sha256-v1"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "entry_count": {"type": "integer", "minimum": 1},
    "total_size": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/projectFile"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "projectFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/projectRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
