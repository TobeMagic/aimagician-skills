{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://window-pptx.local/schemas/auto-binding-report.v1.schema.json",
  "title": "Auto Binding Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "profile_id",
    "profile_sha256",
    "library_index_sha256",
    "query_bundle_sha256",
    "intent_sha256",
    "slide_count",
    "ordinary_slot_count",
    "fact_binding_count",
    "connective_binding_count",
    "fragment_slot_count",
    "governed_policy",
    "plan_sha256",
    "slides"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "pass"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "library_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slide_count": {"type": "integer", "minimum": 1},
    "ordinary_slot_count": {"type": "integer", "minimum": 1},
    "fact_binding_count": {"type": "integer", "minimum": 0},
    "connective_binding_count": {"type": "integer", "minimum": 0},
    "fragment_slot_count": {"type": "integer", "minimum": 0},
    "governed_policy": {"const": "deterministic-authorize-exact"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "page_id",
          "candidate_rank",
          "ordinary_slot_count",
          "fact_binding_count",
          "connective_binding_count",
          "fragment_slot_count",
          "status"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "page_id": {"type": "string", "pattern": "^[0-9a-f]{64}:[0-9]{3}$"},
          "candidate_rank": {"type": "integer", "minimum": 1, "maximum": 10},
          "ordinary_slot_count": {"type": "integer", "minimum": 1},
          "fact_binding_count": {"type": "integer", "minimum": 0},
          "connective_binding_count": {"type": "integer", "minimum": 0},
          "fragment_slot_count": {"type": "integer", "minimum": 0},
          "status": {"const": "pass"}
        }
      }
    }
  }
}
