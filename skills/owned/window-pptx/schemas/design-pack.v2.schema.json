{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-pack.v2.schema.json",
  "title": "Window-PPTX DesignPack v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "runtime_theme_id",
    "scenarios",
    "theme",
    "page_families",
    "pacing",
    "asset_strategy",
    "safe_fallback",
    "art_direction"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "runtime_theme_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "primary",
        "accent",
        "background",
        "heading_font",
        "body_font"
      ],
      "properties": {
        "mode": {"enum": ["light", "dark", "mixed"]},
        "primary": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "background": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
        "heading_font": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "body_font": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "page_families": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_same_family_run", "hero_interval", "density_pattern"],
      "properties": {
        "max_same_family_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "hero_interval": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "density_pattern": {
          "type": "array",
          "minItems": 3,
          "items": {"enum": ["sparse", "balanced", "dense"]}
        }
      }
    },
    "asset_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "required_for"],
      "properties": {
        "priority": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["user", "template", "licensed", "generated", "native"]
          }
        },
        "required_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "safe_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "max_body_chars", "max_items"],
      "properties": {
        "family": {"type": "string"},
        "max_body_chars": {"type": "integer", "minimum": 40},
        "max_items": {"type": "integer", "minimum": 2}
      }
    },
    "template_pack": {"type": "string"},
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "palette_roles",
        "grid",
        "typography_scale_pt",
        "motif",
        "image_crop",
        "icon_style",
        "surface",
        "energy_pattern",
        "quality_thresholds"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "palette_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canvas", "ink", "teal", "gold", "surface", "muted"],
          "properties": {
            "canvas": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "ink": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "teal": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "gold": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "surface": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
            "muted": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "safe_margin_in", "spacing_scale_pt"],
          "properties": {
            "columns": {"type": "integer", "minimum": 8, "maximum": 16},
            "safe_margin_in": {
              "type": "number",
              "minimum": 0.35,
              "maximum": 1.25
            },
            "spacing_scale_pt": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        "typography_scale_pt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "title", "subtitle", "body", "caption"],
          "properties": {
            "display": {"type": "integer", "minimum": 11, "maximum": 72},
            "title": {"type": "integer", "minimum": 11, "maximum": 72},
            "subtitle": {"type": "integer", "minimum": 11, "maximum": 72},
            "body": {"type": "integer", "minimum": 11, "maximum": 72},
            "caption": {"type": "integer", "minimum": 11, "maximum": 72}
          }
        },
        "motif": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variants"],
          "properties": {
            "variants": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {"enum": ["portal", "path", "node", "frame"]}
            }
          }
        },
        "image_crop": {"type": "string", "minLength": 1},
        "icon_style": {"type": "string", "minLength": 1},
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corner_radius_pt", "stroke_pt", "shadow_mode"],
          "properties": {
            "corner_radius_pt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "stroke_pt": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "shadow_mode": {"type": "string", "minLength": 1}
          }
        },
        "energy_pattern": {
          "type": "array",
          "minItems": 3,
          "items": {"enum": ["pause", "flow", "peak"]}
        },
        "quality_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engineering",
            "visual",
            "art",
            "release",
            "axis_floor"
          ],
          "properties": {
            "engineering": {"type": "integer", "minimum": 0, "maximum": 100},
            "visual": {"type": "integer", "minimum": 0, "maximum": 100},
            "art": {"type": "integer", "minimum": 0, "maximum": 100},
            "release": {"type": "integer", "minimum": 0, "maximum": 100},
            "axis_floor": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        }
      }
    }
  }
}
