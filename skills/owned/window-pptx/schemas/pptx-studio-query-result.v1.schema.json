{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/pptx-studio-query-result.v1.schema.json",
  "title": "PPTX Studio Query Result v1",
  "type": "object",
  "required": ["schema_version", "status", "request", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PASS", "NO_MATCH"]},
    "request": {"type": "object"},
    "candidates": {"type": "array", "maxItems": 6}
  },
  "additionalProperties": false
}
