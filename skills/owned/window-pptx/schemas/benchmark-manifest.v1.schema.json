{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/benchmark-manifest.v1.schema.json",
  "title": "Window-PPTX Benchmark Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "corpus_sha256", "protocol_sha256", "thresholds_sha256", "trials"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "thresholds_sha256": {"$ref": "#/$defs/sha256"},
    "trials": {
      "type": "array",
      "minItems": 180,
      "maxItems": 180,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "scenario_id", "arm_id", "model_id", "repeat_index", "seed", "prompt_sha256", "input_sha256", "status"],
      "properties": {
        "trial_id": {"type": "string", "pattern": "^T-[a-z0-9-]+$"},
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "arm_id": {"enum": ["unassisted-json", "governed-plan", "full-v5"]},
        "model_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1, "maximum": 2},
        "seed": {"type": "integer", "minimum": 0},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "planned"}
      }
    }
  }
}
