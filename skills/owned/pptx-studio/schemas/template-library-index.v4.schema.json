{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/template-library-index.v4.schema.json",
  "title": "Template Library Index v4",
  "description": "Compiled index over certified physical pages, including each page's complete governed-content inventory and fail-closed authority policy. Chart/workbook peers are coordinate-derived from c:f ranges and c:pt indices; value-equality guessing is forbidden.",
  "type": "object",
  "required": [
    "schema_version",
    "library_id",
    "compiled_at",
    "source_core_schema",
    "private_root_sha256",
    "source_package_count",
    "source_package_index",
    "page_template_count",
    "role_index",
    "style_cluster_index",
    "deck_family_index",
    "category_index",
    "page_templates",
    "scoring",
    "dominant_style_cluster_id",
    "compatible_style_cluster_ids"
  ],
  "properties": {
    "schema_version": {"const": "4.0"},
    "library_id": {"type": "string", "minLength": 1},
    "compiled_at": {"type": "string", "format": "date-time"},
    "source_core_schema": {
      "enum": [
        "gaojie-certified-core.v2",
        "user-certified-reference-deck.v1"
      ]
    },
    "private_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_package_count": {"type": "integer", "minimum": 1},
    "source_package_index": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["page_count", "source_sha256", "source_size_bytes"],
        "properties": {
          "page_count": {"type": "integer", "minimum": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "page_template_count": {"type": "integer", "minimum": 0},
    "role_index": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "style_cluster_index": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "deck_family_index": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "category_index": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "scoring": {
      "const": {
        "role": 0.3,
        "capacity": 0.25,
        "semantic": 0.2,
        "style": 0.15,
        "editability": 0.1
      }
    },
    "dominant_style_cluster_id": {"type": "string", "minLength": 1},
    "compatible_style_cluster_ids": {
      "description": "Explicitly certified compatibility group. Presence in style_cluster_index alone never permits cross-cluster fallback.",
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "page_templates": {
      "description": "Every page carries governed_content_inventory with source-copy-free semantic and coordinate metadata; legacy or value-guessed records are not schema-valid or direct-use eligible.",
      "type": "array",
      "items": {"$ref": "page-template.v1.schema.json"}
    }
  },
  "additionalProperties": false
}
