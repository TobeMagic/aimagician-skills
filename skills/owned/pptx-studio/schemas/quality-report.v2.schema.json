{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-report.v2.schema.json",
  "title": "pptx-studio QualityReport v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings", "hard_gate_failures", "weighted_defect_score", "passed", "transaction_status"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["namespace", "code", "severity", "slide_id", "object_id", "message", "path", "metric", "threshold", "repairable", "source_stage"], "properties": {"namespace": {"enum": ["input", "narrative", "compile", "render", "preview", "package", "editability"]}, "code": {"type": "string"}, "severity": {"enum": ["hard-gate", "critical", "important", "warning", "info"]}, "slide_id": {"type": ["string", "null"]}, "object_id": {"type": ["string", "null"]}, "message": {"type": "string"}, "path": {"type": ["string", "null"]}, "metric": {"type": ["number", "integer", "string", "null"]}, "threshold": {"type": ["number", "integer", "string", "null"]}, "repairable": {"type": "boolean"}, "source_stage": {"type": "string"}}}},
    "hard_gate_failures": {"type": "array", "items": {"type": "string"}},
    "weighted_defect_score": {"type": "integer", "minimum": 0},
    "passed": {"type": "boolean"},
    "transaction_status": {"type": "string"}
  }
}
