{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/curation-manifest.v1.schema.json",
  "title": "PPTX Studio Curation Manifest v1",
  "type": "object",
  "required": ["schema_version", "status", "active_categories", "inactive_categories", "source_tree_sha256", "active_tree_sha256", "inactive_tree_sha256", "inactive_packages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PLANNED", "APPLIED"]},
    "active_categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inactive_categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inactive_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_tree_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "inactive_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opaque_id", "original_locator", "archive_locator", "source_sha256", "post_move_sha256", "recovery"],
        "properties": {
          "opaque_id": {"type": "string", "pattern": "^pkg_[0-9a-f]{24}$"},
          "original_locator": {"type": "string", "minLength": 1},
          "archive_locator": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "post_move_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recovery": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
