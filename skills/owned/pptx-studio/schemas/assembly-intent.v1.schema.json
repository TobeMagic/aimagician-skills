{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/assembly-intent.v1.schema.json",
  "title": "Assembly Intent v1",
  "description": "Agent-authored semantic intent. It deliberately excludes geometry, source locators, raw template copy, slot IDs, and OOXML details.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "scenario_id",
    "slides"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "page_id", "narrative_role", "fact_ids"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 200},
          "page_id": {"type": "string", "pattern": "^[0-9a-f]{64}:[0-9]{3}$"},
          "narrative_role": {"type": "string", "minLength": 1, "maxLength": 80},
          "fact_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 160},
            "uniqueItems": true,
            "maxItems": 128
          }
        }
      }
    }
  }
}
