{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief-plan.v1.schema.json",
  "title": "pptx-studio restricted BriefPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "groups"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fact_refs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "fact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "beat_hint": {"$ref": "#/$defs/id"},
          "semantic_hint": {"enum": ["bullets", "metrics", "comparison", "sequence", "timeline", "process", "roadmap", "quadrant", "funnel", "trend", "composition", "matrix", "risk", "recommendation", "quote", "table", "image", "statement", "generic"]},
          "importance": {"enum": ["low", "normal", "high", "critical"]}
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {"enum": ["conservative", "professional", "bold", "editorial", "educational"]},
        "density": {"enum": ["sparse", "balanced", "dense"]},
        "audience_mode": {"enum": ["executive", "customer", "investor", "internal", "learner", "general"]},
        "motion": {"enum": ["off", "subtle-fade", "step-reveal"]}
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80}}
}
