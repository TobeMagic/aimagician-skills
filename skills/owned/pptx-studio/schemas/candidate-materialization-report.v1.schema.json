{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/pptx-studio/candidate-materialization-report.v1.schema.json",
  "title": "CandidateMaterializationReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_brief_id", "spine_id", "materializer", "status", "evidence", "adaptation_report"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selection_brief_id": {"type": "string", "minLength": 1},
    "spine_id": {"type": "string", "minLength": 1},
    "materializer": {"enum": ["template_pack_v1_adapter", "registered_native_renderer"]},
    "status": {"enum": ["planned", "pass"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "candidate_id", "spine_id", "source_mode", "materializer", "expected_variant_id", "expected_physical_slide", "observed_layout_id", "observed_output_slide", "source_sha256", "output_sha256", "status"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "spine_id": {"type": "string", "minLength": 1},
          "source_mode": {"enum": ["physical_ooxml", "registered_composition"]},
          "materializer": {"enum": ["template_pack_v1_adapter", "registered_native_renderer"]},
          "expected_variant_id": {"type": ["string", "null"]},
          "expected_physical_slide": {"type": ["integer", "null"], "minimum": 1},
          "observed_layout_id": {"type": ["string", "null"]},
          "observed_output_slide": {"type": ["integer", "null"], "minimum": 1},
          "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["planned", "pass"]}
        }
      }
    },
    "adaptation_report": {"type": ["object", "null"]}
  }
}
