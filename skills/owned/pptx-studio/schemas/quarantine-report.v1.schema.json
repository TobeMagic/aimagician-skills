{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/pptx-studio/quarantine-report.v1.schema.json",
  "title": "Window-PPTX QuarantineReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "disposition",
    "package_sha256",
    "package_size_bytes",
    "entry_count",
    "compressed_bytes",
    "uncompressed_bytes",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PASS", "QUARANTINED"]},
    "disposition": {"enum": ["ACCEPT", "QUARANTINED", "REJECTED"]},
    "package_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "package_size_bytes": {"type": "integer", "minimum": 0},
    "entry_count": {"type": "integer", "minimum": 0},
    "compressed_bytes": {"type": "integer", "minimum": 0},
    "uncompressed_bytes": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "enum": [
              "TRAVERSAL_PATH",
              "DUPLICATE_ENTRY",
              "ENCRYPTED_ENTRY",
              "SYMLINK_ENTRY",
              "MACRO_CONTENT",
              "OLE_CONTENT",
              "ACTIVEX_CONTENT",
              "EXTERNAL_RELATIONSHIP",
              "XML_DTD_CONTENT",
              "MALFORMED_RELATIONSHIP_XML",
              "RELATIONSHIP_XML_SIZE_LIMIT",
              "CONTENT_TYPES_XML_SIZE_LIMIT",
              "MALFORMED_ARCHIVE",
              "ENTRY_COUNT_LIMIT",
              "UNCOMPRESSED_SIZE_LIMIT",
              "COMPRESSION_RATIO_LIMIT"
            ]
          },
          "path": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "ACCEPT"}}},
      "then": {
        "properties": {
          "status": {"const": "PASS"},
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {"enum": ["QUARANTINED", "REJECTED"]}
        }
      },
      "then": {
        "properties": {
          "status": {"const": "QUARANTINED"},
          "findings": {"minItems": 1}
        }
      }
    }
  ]
}
