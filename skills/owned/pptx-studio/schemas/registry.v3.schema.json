{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/registry.v3.schema.json",
  "title": "Template Intelligence Registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "candidate_count", "source_digests", "derivation", "specialty_aliases", "spines"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "candidate_count": {"const": 84},
    "source_digests": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "derivation": {"type": "object"},
    "specialty_aliases": {"type": "array", "minItems": 9, "maxItems": 9},
    "spines": {"type": "array", "minItems": 3, "maxItems": 3}
  }
}
