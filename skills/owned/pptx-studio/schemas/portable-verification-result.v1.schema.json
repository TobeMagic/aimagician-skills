{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-verification-result.v1.schema.json",
  "title": "pptx-studio staged verification result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "ooxml", "libreoffice", "quality", "powerpoint"],
  "properties": {
    "level": {"enum": ["portable", "powerpoint"]},
    "ooxml": {"$ref": "#/$defs/ooxml"},
    "libreoffice": {"$ref": "#/$defs/libreoffice"},
    "quality": {"$ref": "#/$defs/quality"},
    "powerpoint": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/powerpoint"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"level": {"const": "portable"}}},
      "then": {"properties": {"powerpoint": {"type": "null"}}}
    },
    {
      "if": {"properties": {"level": {"const": "powerpoint"}}},
      "then": {"properties": {"powerpoint": {"$ref": "#/$defs/powerpoint"}}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ooxml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "slide_count", "object_ids", "chart_count", "table_count",
        "diagram_count", "notes_count", "hyperlink_count", "part_count"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "slide_count": {"type": "integer", "minimum": 1},
        "object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "chart_count": {"type": "integer", "minimum": 0},
        "table_count": {"type": "integer", "minimum": 0},
        "diagram_count": {"type": "integer", "minimum": 0},
        "notes_count": {"type": "integer", "minimum": 0},
        "hyperlink_count": {"type": "integer", "minimum": 0},
        "part_count": {"type": "integer", "minimum": 1}
      }
    },
    "libreoffice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "engine", "engine_version", "poppler_version", "page_count",
        "page_width_pt", "page_height_pt", "pdf_path", "png_paths",
        "candidate_hash_before", "candidate_hash_after"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "engine": {"const": "libreoffice"},
        "engine_version": {"type": "string", "minLength": 1},
        "poppler_version": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "page_width_pt": {"type": "number", "exclusiveMinimum": 0},
        "page_height_pt": {"type": "number", "exclusiveMinimum": 0},
        "pdf_path": {"type": "string", "minLength": 1},
        "png_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_hash_before": {"$ref": "#/$defs/sha"},
        "candidate_hash_after": {"$ref": "#/$defs/sha"}
      }
    },
    "qualityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace", "code", "severity", "slide_id", "object_id", "message",
        "path", "metric", "threshold", "repairable", "source_stage"
      ],
      "properties": {
        "namespace": {"enum": ["input", "narrative", "compile", "render", "preview", "package", "editability"]},
        "code": {"type": "string"},
        "severity": {"enum": ["hard-gate", "critical", "important", "warning", "info"]},
        "slide_id": {"type": ["string", "null"]},
        "object_id": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "metric": {"type": ["number", "integer", "string", "null"]},
        "threshold": {"type": ["number", "integer", "string", "null"]},
        "repairable": {"type": "boolean"},
        "source_stage": {"type": "string"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "findings", "hard_gate_failures", "weighted_defect_score", "passed", "transaction_status"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/qualityFinding"}},
        "hard_gate_failures": {"type": "array", "items": {"type": "string"}},
        "weighted_defect_score": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"},
        "transaction_status": {"type": "string"}
      }
    },
    "powerpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerpoint_version", "pdf_path", "png_paths", "candidate_hash_before",
        "candidate_hash_after", "owned_pid"
      ],
      "properties": {
        "powerpoint_version": {"type": "string", "minLength": 1},
        "pdf_path": {"type": "string", "minLength": 1},
        "png_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "candidate_hash_before": {"$ref": "#/$defs/sha"},
        "candidate_hash_after": {"$ref": "#/$defs/sha"},
        "owned_pid": {"type": "integer", "minimum": 1}
      }
    }
  }
}
