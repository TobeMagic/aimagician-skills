{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/pptx-studio/benchmark-run-contract.v1.schema.json",
  "title": "Window-PPTX Formal Benchmark Run Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_kind",
    "benchmark_id",
    "benchmark_root",
    "manifest_sha256",
    "fingerprint_bundle_sha256",
    "timeout_seconds",
    "trial_count",
    "trial_selection",
    "response_source",
    "manifest_only",
    "resume_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_kind": {"const": "formal"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_root": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "fingerprint_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "timeout_seconds": {"const": 90},
    "trial_count": {"const": 180},
    "trial_selection": {"const": "all"},
    "response_source": {"const": "live-provider"},
    "manifest_only": {"const": false},
    "resume_policy": {"const": "exact-contract"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
