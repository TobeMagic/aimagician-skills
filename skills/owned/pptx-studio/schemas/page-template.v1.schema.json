{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/page-template.v1.schema.json",
  "title": "Page Template v1",
  "description": "One certified physical page template, distilled from a source package.",
  "type": "object",
  "required": [
    "schema_version",
    "page_id",
    "package_sha256",
    "slide_number",
    "source_path",
    "source_sha256",
    "source_slide_sha256",
    "page_role",
    "category_names",
    "style_cluster_id",
    "deck_family_id",
    "theme_palette",
    "capacity",
    "editability",
    "certification",
    "structure",
    "slot_graph",
    "governed_content_inventory",
    "requires_customer_asset",
    "media_retention_policy",
    "pool",
    "decision",
    "direct_use",
    "eligibility_known",
    "style_features"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "page_id": {"type": "string", "pattern": "^[0-9a-f]{64}:[0-9]{3}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slide_number": {"type": "integer", "minimum": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_slide_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_role": {
      "type": "string",
      "enum": [
        "cover", "agenda", "contents", "section", "body", "decision", "closing", "cta", "appendix",
        "cover-2", "contents-2", "section-2", "body-2", "decision-2",
        "data-chart", "process", "timeline", "team", "table", "case-study",
        "big-number", "comparison", "matrix", "quote", "roadmap",
        "awards", "people", "mockup", "logo-wall", "business-model", "image-text",
        "map", "supporting-asset", "data", "kpi", "statement", "content-blocks"
      ]
    },
    "category_names": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "style_cluster_id": {"type": "string", "minLength": 1},
    "deck_family_id": {"type": "string", "minLength": 1},
    "pool": {"type": ["string", "null"]},
    "decision": {"type": ["string", "null"]},
    "direct_use": {"type": "boolean"},
    "eligibility_known": {"type": "boolean"},
    "style_features": {
      "type": "object",
      "properties": {
        "tone": {"enum": ["dark", "mid", "light"]},
        "average_luminance": {"type": "integer", "minimum": 0, "maximum": 255},
        "average_chroma": {"type": "integer", "minimum": 0, "maximum": 255},
        "accent_family": {"type": "string", "minLength": 1},
        "visual_mode": {"enum": ["editorial", "research-evidence", "visual-stage"]},
        "density": {"enum": ["sparse", "balanced", "dense"]},
        "density_score": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "theme_palette": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "minItems": 3, "maxItems": 6},
    "capacity": {
      "type": "object",
      "required": ["max_text_chars"],
      "properties": {
        "max_text_chars": {"type": "integer", "minimum": 0},
        "max_text_runs": {"type": "integer", "minimum": 0}
      }
    },
    "editability": {"type": "string", "enum": ["native_editable", "image_only"]},
    "certification": {"const": "certified"},
    "requires_customer_asset": {"type": "boolean"},
    "media_retention_policy": {
      "enum": [
        "no-page-media",
        "customer-replacement-required",
        "certified-decorative-retain"
      ]
    },
    "visual_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "structure": {
      "type": "object",
      "required": [
        "slide_count", "shape_count", "layout_count", "master_count",
        "theme_count", "media_count", "page_shape_count",
        "slide_relationship_count", "linked_style_part_count",
        "page_image_count", "page_media_count", "page_chart_count",
        "page_table_count", "page_native_object_count"
      ],
      "properties": {
        "slide_count": {"type": "integer", "minimum": 1},
        "shape_count": {"type": "integer", "minimum": 0},
        "layout_count": {"type": "integer", "minimum": 1},
        "master_count": {"type": "integer", "minimum": 1},
        "theme_count": {"type": "integer", "minimum": 1},
        "media_count": {"type": "integer", "minimum": 0},
        "chart_count": {"type": "integer", "minimum": 0},
        "table_count": {"type": "integer", "minimum": 0},
        "page_shape_count": {"type": "integer", "minimum": 0},
        "slide_relationship_count": {"type": "integer", "minimum": 0},
        "linked_style_part_count": {"type": "integer", "minimum": 0},
        "page_image_count": {"type": "integer", "minimum": 0},
        "page_media_count": {"type": "integer", "minimum": 0},
        "page_chart_count": {"type": "integer", "minimum": 0},
        "page_table_count": {"type": "integer", "minimum": 0},
        "page_native_object_count": {"type": "integer", "minimum": 0},
        "fonts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "slot_graph": {
      "type": "object",
      "required": ["text_slot_ids", "text_slot_count", "reading_order", "fragment_groups", "slots"],
      "properties": {
        "text_slot_ids": {"type": "array", "items": {"type": "string"}},
        "text_slot_count": {"type": "integer", "minimum": 0},
        "reading_order": {"type": "array", "items": {"type": "string"}},
        "fragment_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group_id", "slot_ids"],
            "properties": {
              "group_id": {"type": "string", "pattern": "^fragment_[0-9]{2}$"},
              "slot_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot_id", "shape_id", "kind", "semantic_role", "region",
              "reading_order", "bbox", "max_chars", "source_char_count",
              "source_line_count", "source_run_count", "source_text_sha256",
              "source_text", "group_id", "group_order", "font_size_pt",
              "allowed_binding_modes"
            ],
            "properties": {
              "slot_id": {"type": "string"},
              "shape_id": {"type": "integer", "minimum": 1},
              "kind": {"type": "string"},
              "semantic_role": {
                "enum": [
                  "title", "subtitle", "body", "label", "metric", "footer",
                  "title_fragment", "label_fragment"
                ]
              },
              "region": {
                "enum": [
                  "top-left", "top-center", "top-right", "middle-left",
                  "middle-center", "middle-right", "bottom-left",
                  "bottom-center", "bottom-right"
                ]
              },
              "reading_order": {"type": "integer", "minimum": 1},
              "bbox": {
                "type": "object",
                "required": ["x", "y", "w", "h"],
                "properties": {
                  "x": {"type": "integer", "minimum": 0, "maximum": 1000},
                  "y": {"type": "integer", "minimum": 0, "maximum": 1000},
                  "w": {"type": "integer", "minimum": 0, "maximum": 1000},
                  "h": {"type": "integer", "minimum": 0, "maximum": 1000}
                },
                "additionalProperties": false
              },
              "max_chars": {"type": "integer", "minimum": 1},
              "source_char_count": {"type": "integer", "minimum": 1},
              "source_line_count": {"type": "integer", "minimum": 1},
              "source_run_count": {"type": "integer", "minimum": 1},
              "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_text": {"type": "string"},
              "group_id": {"type": ["string", "null"]},
              "group_order": {"type": ["integer", "null"], "minimum": 1},
              "font_size_pt": {"type": ["number", "null"], "minimum": 1},
              "allowed_binding_modes": {
                "type": "array",
                "minItems": 1,
                "items": {"enum": ["fact", "connective", "character", "clear"]},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "governed_content_inventory": {
      "type": "object",
      "required": [
            "schema_version",
            "peer_mapping_method",
            "policy",
        "complete",
        "content_slot_count",
        "customer_data_slot_count",
        "slots",
        "closure_metadata",
        "scan_errors"
      ],
      "properties": {
            "schema_version": {
              "const": "governed-content-inventory.v1"
            },
            "peer_mapping_method": {
              "description": "Only coordinate-derived chart/workbook pairing can restore direct-use eligibility; unknown marks a legacy fail-closed inventory.",
              "enum": ["chart-formula-range-v1", "unknown"]
            },
        "policy": {
          "enum": [
            "no-embedded-content",
            "locked-authority-required"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "content_slot_count": {
          "type": "integer",
          "minimum": 0
        },
        "customer_data_slot_count": {
          "type": "integer",
          "minimum": 0
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot_id",
              "kind",
              "source_part",
              "locator",
              "source_text",
              "source_text_sha256",
              "peer_group_id",
              "semantic_role",
              "series_index",
              "point_index",
              "worksheet_ordinal",
              "cell_ref",
              "value_type"
            ],
            "properties": {
              "slot_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$"
              },
              "kind": {
                "enum": [
                  "table-cell",
                  "chart-value",
                  "chart-text",
                  "workbook-cell",
                  "notes-text",
                  "comment-text",
                  "diagram-text"
                ]
              },
              "source_part": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "source_text": {
                "type": "string"
              },
              "source_text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "peer_group_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^peer_[0-9a-f]{24}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "semantic_role": {
                "description": "Source-copy-free content role used by the planner. Chart and workbook peer members carry the same role.",
                "enum": [
                  "table-cell",
                  "chart-title",
                  "chart-text",
                  "series-name",
                  "category",
                  "value",
                  "chart-unreferenced",
                  "workbook-unreferenced",
                  "notes-text",
                  "comment-text",
                  "diagram-text"
                ]
              },
              "series_index": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "point_index": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "worksheet_ordinal": {
                "description": "Zero-based workbook sheet coordinate; raw worksheet names are not exported as planning evidence.",
                "type": ["integer", "null"],
                "minimum": 0
              },
              "cell_ref": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
                  },
                  {"type": "null"}
                ]
              },
              "value_type": {
                "enum": [
                  "text",
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "closure_metadata": {
          "type": "object",
          "required": [
            "table_count",
            "chart_part_count",
            "workbook_part_count",
            "notes_part_count",
            "comment_part_count",
            "diagram_part_count",
            "layout_master_field_count",
            "layout_master_fields",
            "tag_part_count",
            "tag_parts",
            "media_count",
            "media_parts"
          ],
          "properties": {
            "table_count": {
              "type": "integer",
              "minimum": 0
            },
            "chart_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "workbook_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "notes_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "comment_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "diagram_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "layout_master_field_count": {
              "type": "integer",
              "minimum": 0
            },
            "layout_master_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field_id",
                  "source_part",
                  "locator",
                  "field_type",
                  "source_text_sha256"
                ],
                "properties": {
                  "field_id": {
                    "type": "string",
                    "pattern": "^field_[0-9a-f]{24}$"
                  },
                  "source_part": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_text_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "tag_part_count": {
              "type": "integer",
              "minimum": 0
            },
            "tag_parts": {
              "$ref": "#/$defs/hashedParts"
            },
            "media_count": {
              "type": "integer",
              "minimum": 0
            },
            "media_parts": {
              "$ref": "#/$defs/hashedParts"
            }
          },
          "additionalProperties": false
        },
        "scan_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
          {
            "if": {
              "properties": {
                "complete": {"const": true}
              },
              "required": ["complete"]
            },
            "then": {
              "properties": {
                "peer_mapping_method": {"const": "chart-formula-range-v1"},
                "scan_errors": {"maxItems": 0}
              }
            }
          },
          {
            "if": {
            "properties": {
              "policy": {
                "const": "no-embedded-content"
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "content_slot_count": {
                "const": 0
              },
              "customer_data_slot_count": {
                "const": 0
              },
              "slots": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "locked-authority-required"
              },
              "complete": {
                "const": true
              }
            },
            "required": [
              "policy",
              "complete"
            ]
          },
          "then": {
            "properties": {
              "content_slot_count": {
                "minimum": 1
              },
              "customer_data_slot_count": {
                "minimum": 1
              },
              "slots": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "hashedParts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_part",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "source_part": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "governed_content_inventory": {
            "properties": {
              "complete": {
                "const": false
              }
            },
            "required": [
              "complete"
            ]
          }
        },
        "required": [
          "governed_content_inventory"
        ]
      },
      "then": {
        "properties": {
          "direct_use": {
            "const": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
