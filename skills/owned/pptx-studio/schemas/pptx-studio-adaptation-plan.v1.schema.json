{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/pptx-studio-adaptation-plan.v1.schema.json",
  "title": "PPTX Studio Governed Adaptation Plan v1",
  "type": "object",
  "required": ["schema_version", "status", "composition_plan_sha256", "adaptation_request_sha256", "operations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "PASS"},
    "composition_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adaptation_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations": {"type": "array"}
  },
  "additionalProperties": false
}
