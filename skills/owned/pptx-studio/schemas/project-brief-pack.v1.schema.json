{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-brief-pack.v1.schema.json",
  "title": "pptx-studio ProjectBriefPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "scenario_id",
    "state",
    "raw_intake",
    "fact_store",
    "assets",
    "audience",
    "goals",
    "timing",
    "brand",
    "slide_budget",
    "anatomy",
    "decisions",
    "prohibitions",
    "rubric",
    "unresolved_questions",
    "lock_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "brief_id": {"$ref": "#/$defs/id"},
    "scenario_id": {"$ref": "#/$defs/id"},
    "state": {"enum": ["Draft", "NeedsDiscussion", "Locked"]},
    "raw_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "received_at",
        "language",
        "original_request",
        "attachments"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "received_at": {"type": "string", "format": "date"},
        "language": {"type": "string", "minLength": 2, "maxLength": 20},
        "original_request": {"type": "string", "minLength": 1, "maxLength": 20000},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "locator", "kind", "rights"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
              "kind": {
                "enum": ["document", "data", "image", "video", "audio", "template", "other"]
              },
              "rights": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      }
    },
    "fact_store": {"$ref": "fact-store.v1.schema.json"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "source_id", "locator", "rights", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "role": {"type": "string", "minLength": 1, "maxLength": 80},
          "source_id": {"$ref": "#/$defs/id"},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1000},
          "rights": {"type": "string", "minLength": 1, "maxLength": 200},
          "required": {"type": "boolean"}
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "knowledge_level", "decision_role"],
      "properties": {
        "primary": {"type": "string", "minLength": 1, "maxLength": 300},
        "knowledge_level": {"enum": ["novice", "mixed", "informed", "expert"]},
        "decision_role": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "decision", "success_outcomes"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "decision": {"type": "string", "minLength": 1, "maxLength": 500},
        "success_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_minutes", "qa_minutes"],
      "properties": {
        "presentation_minutes": {"type": "integer", "minimum": 1, "maximum": 480},
        "qa_minutes": {"type": "integer", "minimum": 0, "maximum": 480}
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "mode", "required_colors", "forbidden_styles"],
      "properties": {
        "tone": {"type": "string", "minLength": 1, "maxLength": 100},
        "mode": {"enum": ["light", "dark", "mixed"]},
        "required_colors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        },
        "forbidden_styles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "slide_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "minimum", "maximum", "appendix", "backup"],
      "properties": {
        "main": {"type": "integer", "minimum": 1, "maximum": 200},
        "minimum": {"type": "integer", "minimum": 1, "maximum": 200},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 200},
        "appendix": {"type": "integer", "minimum": 0, "maximum": 100},
        "backup": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "required", "min_count", "max_count"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 80},
          "required": {"type": "boolean"},
          "min_count": {"type": "integer", "minimum": 0, "maximum": 100},
          "max_count": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "weight", "minimum_score"],
        "properties": {
          "criterion": {"$ref": "#/$defs/id"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "minimum_score": {"type": "number", "minimum": 0, "maximum": 5}
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "lock_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    }
  }
}
