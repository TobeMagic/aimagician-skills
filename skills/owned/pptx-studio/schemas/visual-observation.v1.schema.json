{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/visual-observation.v1.schema.json",
  "title": "PPTX Studio Visual Observation v1",
  "type": "object",
  "required": ["schema_version", "page_id", "image_sha256", "observation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "page_id": {"type": "string", "pattern": "^page_[0-9a-f]{24}_[0-9]{3}$"},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {"type": "object"}
  },
  "additionalProperties": false
}
