{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/catalog.v3.schema.json",
  "title": "Window-PPTX Catalog v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "entries"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_item_id",
        "source_id",
        "item_id",
        "version_id",
        "content_sha256",
        "media_type",
        "geometry",
        "phash",
        "capacity",
        "scenarios",
        "style_tags",
        "rights_decision",
        "rights_record_digest",
        "quarantine_disposition",
        "quarantine_report_digest",
        "dependency_ids",
        "editability",
        "certification",
        "provenance"
      ],
      "properties": {
        "catalog_item_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {"type": "string", "minLength": 1},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_in", "height_in", "slide_count"],
          "properties": {
            "width_in": {"type": "number", "exclusiveMinimum": 0},
            "height_in": {"type": "number", "exclusiveMinimum": 0},
            "slide_count": {"type": "integer", "minimum": 1}
          }
        },
        "phash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["present", "not_applicable", "pending"]},
            "value": {"type": "string", "pattern": "^[0-9a-f]+$"}
          },
          "allOf": [
            {
              "if": {"properties": {"state": {"const": "present"}}},
              "then": {"required": ["value"]}
            },
            {
              "if": {"properties": {"state": {"enum": ["not_applicable", "pending"]}}},
              "then": {"not": {"required": ["value"]}}
            }
          ]
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_slides", "max_slides", "max_text_chars"],
          "properties": {
            "min_slides": {"type": "integer", "minimum": 1},
            "max_slides": {"type": "integer", "minimum": 1},
            "max_text_chars": {"type": "integer", "minimum": 1}
          }
        },
        "scenarios": {"$ref": "#/$defs/stringArray"},
        "style_tags": {"$ref": "#/$defs/stringArray"},
        "rights_decision": {"enum": ["allowed", "restricted", "unknown"]},
        "rights_record_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quarantine_disposition": {
          "enum": ["ACCEPT", "QUARANTINED", "REJECTED", "NOT_RUN"]
        },
        "quarantine_report_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependency_ids": {"$ref": "#/$defs/stringArray"},
        "editability": {
          "enum": ["native_editable", "partially_editable", "flattened", "unknown"]
        },
        "certification": {
          "enum": ["certified", "quarantined", "unverified", "revoked"]
        },
        "provenance": {"$ref": "#/$defs/stringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"certification": {"const": "certified"}}},
          "then": {
            "properties": {
              "rights_decision": {"const": "allowed"},
              "rights_record_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "quarantine_disposition": {"const": "ACCEPT"},
              "quarantine_report_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "editability": {
                "enum": ["native_editable", "partially_editable", "flattened"]
              },
              "style_tags": {"minItems": 1},
              "provenance": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
