{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/pptx-studio/blind-review-score.v1.schema.json",
  "title": "Window-PPTX Completed Blind Review Score Sheet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "packet_sha256", "reviewer_id", "reviews"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_id": {"type": "string", "pattern": "^R-[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
    "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_id", "evidence_sha256", "scores", "notes"],
      "properties": {
        "blind_id": {"type": "string", "pattern": "^B-[0-9]{3}-[0-9a-f]{8}$"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrative_clarity", "content_accuracy", "visual_hierarchy", "layout_fitness_variety", "readability", "chart_diagram_appropriateness", "brand_consistency", "editability", "customer_delivery_readiness"],
          "properties": {
            "narrative_clarity": {"$ref": "#/$defs/score"},
            "content_accuracy": {"$ref": "#/$defs/score"},
            "visual_hierarchy": {"$ref": "#/$defs/score"},
            "layout_fitness_variety": {"$ref": "#/$defs/score"},
            "readability": {"$ref": "#/$defs/score"},
            "chart_diagram_appropriateness": {"$ref": "#/$defs/score"},
            "brand_consistency": {"$ref": "#/$defs/score"},
            "editability": {"$ref": "#/$defs/score"},
            "customer_delivery_readiness": {"$ref": "#/$defs/score"}
          }
        },
        "notes": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
