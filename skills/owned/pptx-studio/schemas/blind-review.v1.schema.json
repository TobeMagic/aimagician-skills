{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/window-pptx/blind-review.v1.schema.json",
  "title": "Window-PPTX Blind Review Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "packet_sha256", "delivery_evidence_ready", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delivery_evidence_ready": {"type": "boolean"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_id", "scenario_id", "evidence_sha256", "rubric", "artifacts"],
      "properties": {
        "blind_id": {"type": "string", "pattern": "^B-[0-9]{3}-[0-9a-f]{8}$"},
        "scenario_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubric": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "review_path", "sha256", "size_bytes"],
            "properties": {
              "kind": {"enum": ["editable-pptx", "slide-preview"]},
              "review_path": {"type": "string", "pattern": "^B-[0-9]{3}-[0-9a-f]{8}/(?:delivery\\.pptx|slide-[0-9]{3}\\.png)$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
