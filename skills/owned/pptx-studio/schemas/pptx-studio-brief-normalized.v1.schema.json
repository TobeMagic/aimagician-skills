{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/pptx-studio-brief-normalized.v1.schema.json",
  "title": "PPTX Studio Normalized Client Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "audience", "purpose", "delivery_context", "facts", "assets", "constraints", "assumptions"],
  "properties": {
    "schema_version": {"const": "pptx-studio-brief-normalized.v1"},
    "brief_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "delivery_context": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "value"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}}},
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "sha256"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
