{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptx-studio.local/schemas/pptx-studio-adaptation-request.v1.schema.json",
  "title": "PPTX Studio Governed Adaptation Request v1",
  "type": "object",
  "required": ["schema_version", "facts", "assets", "bindings", "structured_data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "value"],
        "properties": {"fact_id": {"type": "string", "minLength": 1}, "value": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "sha256"],
        "properties": {"asset_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "operation", "region_id", "shape_id", "fact_id", "asset_id"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "operation": {"enum": ["replace_text", "replace_asset"]},
          "region_id": {"type": ["string", "null"]},
          "shape_id": {"type": ["string", "null"]},
          "fact_id": {"type": ["string", "null"]},
          "asset_id": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "structured_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "contract_id", "values"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "contract_id": {"type": "string", "minLength": 1},
          "values": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
