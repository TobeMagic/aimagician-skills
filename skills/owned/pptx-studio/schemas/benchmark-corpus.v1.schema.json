{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimagician.local/pptx-studio/benchmark-corpus.v1.schema.json",
  "title": "Window-PPTX Benchmark Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "required_terms"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "text": {"type": "string", "minLength": 1},
        "required_terms": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "language", "audience", "objective", "expected_archetype", "slide_count_range", "required_beats", "expected_forms", "asset_condition", "facts", "prohibited_claims"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "expected_archetype": {"$ref": "#/$defs/identifier"},
        "slide_count_range": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 5},
            {"type": "integer", "minimum": 5}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "required_beats": {"$ref": "#/$defs/nonEmptyStrings"},
        "expected_forms": {"$ref": "#/$defs/nonEmptyStrings"},
        "asset_condition": {"type": "string", "minLength": 1},
        "facts": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/fact"}
        },
        "prohibited_claims": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
