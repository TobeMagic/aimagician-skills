{
  "schema_version": "2.0",
  "id": "product-launch-stage",
  "name": "Product Launch Stage",
  "runtime_theme_id": "technology",
  "scenarios": ["product-launch", "sales-proposal", "investor-pitch", "brand-introduction", "ecommerce-marketing"],
  "theme": {
    "mode": "dark",
    "primary": "111827",
    "accent": "7C3AED",
    "background": "090B10",
    "heading_font": ["Inter Display", "Arial", "Noto Sans CJK SC"],
    "body_font": ["Inter", "Arial", "Noto Sans CJK SC"]
  },
  "page_families": ["cover", "section", "problem-hero", "product-hero", "big-number", "feature-bento", "before-after", "demo-flow", "architecture", "social-proof", "pricing", "roadmap", "team", "cta", "closing"],
  "pacing": {
    "max_same_family_run": 2,
    "hero_interval": 3,
    "density_pattern": ["sparse", "balanced", "sparse", "dense"]
  },
  "asset_strategy": {
    "priority": ["user", "generated", "licensed", "native"],
    "required_for": ["cover", "product-hero", "feature-bento", "social-proof"]
  },
  "safe_fallback": {
    "family": "stage-hero-with-proof-strip",
    "max_body_chars": 120,
    "max_items": 4
  },
  "art_direction": {
    "id": "luminous-product-stage",
    "palette_roles": {
      "canvas": "090B10",
      "ink": "F7F4FF",
      "teal": "18B6A4",
      "gold": "A78BFA",
      "surface": "151A24",
      "muted": "9CA3AF"
    },
    "grid": {
      "columns": 12,
      "safe_margin_in": 0.58,
      "spacing_scale_pt": [4, 8, 12, 16, 24, 36, 52]
    },
    "typography_scale_pt": {
      "display": 56,
      "title": 34,
      "subtitle": 22,
      "body": 16,
      "caption": 11
    },
    "motif": {
      "variants": ["stage-arc", "orbit", "device-glow", "beam"]
    },
    "image_crop": "cover-with-subject-safe-zone",
    "icon_style": "solid-rounded-duotone",
    "surface": {
      "corner_radius_pt": 12,
      "stroke_pt": 1,
      "shadow_mode": "high-contrast-stage"
    },
    "energy_pattern": ["peak", "flow", "peak", "pause"],
    "quality_thresholds": {
      "engineering": 100,
      "visual": 80,
      "art": 75,
      "release": 84,
      "axis_floor": 75
    }
  }
}
