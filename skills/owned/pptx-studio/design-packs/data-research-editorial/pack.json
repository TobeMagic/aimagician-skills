{
  "schema_version": "2.0",
  "id": "data-research-editorial",
  "name": "Data Research Editorial",
  "runtime_theme_id": "finance-investor",
  "scenarios": ["market-analysis", "data-analysis", "research-report", "training-deck"],
  "theme": {
    "mode": "light",
    "primary": "0F4C5C",
    "accent": "2A7F86",
    "background": "F5F3EE",
    "heading_font": ["Source Han Serif SC", "Noto Serif CJK SC", "Arial"],
    "body_font": ["Source Han Sans SC", "Noto Sans CJK SC", "Arial"]
  },
  "page_families": ["cover", "section", "abstract", "method", "big-number", "annotated-chart", "small-multiples", "distribution", "comparison", "matrix", "table", "evidence-cards", "process", "training-concept", "takeaways", "closing"],
  "pacing": {
    "max_same_family_run": 2,
    "hero_interval": 5,
    "density_pattern": ["balanced", "dense", "dense", "sparse"]
  },
  "asset_strategy": {
    "priority": ["user", "licensed", "generated", "native"],
    "required_for": ["cover", "training-concept"]
  },
  "safe_fallback": {
    "family": "annotated-evidence-with-takeaway",
    "max_body_chars": 240,
    "max_items": 7
  },
  "art_direction": {
    "id": "evidence-margin",
    "palette_roles": {
      "canvas": "F5F3EE",
      "ink": "13343B",
      "teal": "0F6B78",
      "gold": "2A7F86",
      "surface": "FFFFFF",
      "muted": "68777A"
    },
    "grid": {
      "columns": 12,
      "safe_margin_in": 0.64,
      "spacing_scale_pt": [4, 8, 12, 18, 24, 32, 48]
    },
    "typography_scale_pt": {
      "display": 46,
      "title": 30,
      "subtitle": 21,
      "body": 15,
      "caption": 11
    },
    "motif": {
      "variants": ["datum-line", "evidence-bracket", "annotation-dot", "editorial-rule"]
    },
    "image_crop": "cover-with-caption-safe-zone",
    "icon_style": "monoline-data-consistent",
    "surface": {
      "corner_radius_pt": 4,
      "stroke_pt": 1,
      "shadow_mode": "paper-separation-only"
    },
    "energy_pattern": ["flow", "flow", "peak", "pause"],
    "quality_thresholds": {
      "engineering": 100,
      "visual": 80,
      "art": 75,
      "release": 84,
      "axis_floor": 75
    }
  }
}
